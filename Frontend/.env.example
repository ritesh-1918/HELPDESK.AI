# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (required)
VITE_BACKEND_URL=http://localhost:8000

# Stripe (optional - for landing page pricing links)
VITE_STRIPE_GROWTH_LINK=your_stripe_link

# YouTube API (optional - for Help page tutorials)
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# Gemini API Keys (optional - for AI assistant)
VITE_GEMINI_API_KEY_1=key1
VITE_GEMINI_API_KEY_2=key2
VITE_GEMINI_API_KEY_3=key3
VITE_GEMINI_API_KEY_4=key4
VITE_AI_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# OpenRouter API Keys (optional - for AI assistant)
VITE_OPENROUTER_API_KEY_1=key1
VITE_OPENROUTER_API_KEY_2=key2
VITE_OPENROUTER_API_KEY_3=key3
VITE_OPENROUTER_API_KEY_4=key4
VITE_AI_OPENROUTER_MODELS=meta-llama/llama-3.2-3b-instruct:free,microsoft/phi-3-mini-128k-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free

# Groq API Keys (optional - for AI assistant)
VITE_GROQ_API_KEY_1=key1
VITE_GROQ_API_KEY_2=key2
VITE_GROQ_API_KEY_3=key3
VITE_AI_GROQ_MODELS=llama-3.1-8b-instant,mixtral-8x7b-32768,gemma2-9b-it
