# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API URL (primary)
# Used by config.js as the single source of truth for API base URL
VITE_API_URL=http://localhost:8000

# Legacy alias (still supported for backward compat — VITE_API_URL takes precedence)
# VITE_BACKEND_URL=http://localhost:8000

# Set to 'false' to disable mock data and use real backend
# VITE_USE_MOCK=true
