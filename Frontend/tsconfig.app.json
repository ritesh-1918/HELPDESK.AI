{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Relaxed rules for initial migration */
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
